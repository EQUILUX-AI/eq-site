---
import '../styles/global.css';
import { reader } from '../lib/reader';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const settings = await reader.singletons.settings.readOrThrow();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={settings.logo ?? '/favicon.svg'} />
    <title>{title ? `${title} | ${settings.siteName}` : settings.siteName}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        {settings.logo && <img src={settings.logo} alt="" width="40" height="40" />}
        <span>{settings.siteName}</span>
      </a>
      <nav>
        {settings.nav.map((item) => (
          <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">{settings.footer}</footer>
  </body>
</html>
