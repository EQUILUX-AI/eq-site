---
import Base from '../../layouts/Base.astro';
---

<Base title="Open the Equilux app">
  <section class="container narrow not-found">
    <h1>Open the Equilux app</h1>
    <p>
      This sign-in code opens in the Equilux app. Scan it with the camera of a
      phone that has the app installed.
    </p>
    <p>
      If the app didn't open, make sure it's installed and up to date, then make
      a new code in Equilux Admin. Each code works once, for 2 minutes.
    </p>
    <p><a class="button" href="/">Back to home</a></p>
  </section>
</Base>
