---
import Base from '../../layouts/Base.astro';
---

<Base title="Return to the Equilux app">
  <section class="container narrow not-found">
    <h1>Return to the Equilux app</h1>
    <p>
      Your sign-in is almost done. Open the Equilux app on this phone to finish
      connecting your device.
    </p>
    <p>
      If the app didn't open, make sure it's installed and up to date, then start
      the connection again from the app.
    </p>
    <p><a class="button" href="/">Back to home</a></p>
  </section>
</Base>
